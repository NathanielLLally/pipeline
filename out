                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    +| 
                                      |                                      |                                     |                                     |           |             |             |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      | Sometimes the most important dog training doesn't look very impressive. Maddy's dad has a fused spine and uses a cane, which means he has to walk very slowly. For Maddy, pulling or even walking at a normal German Shepherd pace could put him at risk of falling. So we taught her something very specific: match Dad's pace. Stay in heel. Don't forge ahead. Don't pull. Adjust YOUR speed to the person you're walking with. And because bending down to retrieve a dropped cane is extremely difficult for him, we added one more skill—pick it up and bring it back. It's only a 24-second video, and the first part may look like the most boring heel you've ever seen. But that's the point. Good dog training isn't about showing off what a dog can do. It's about teaching the dog what their person actually NEEDS them to do.                                                                         